{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@forge/sdk": "workspace:*"
  },
  "devDependencies": {
    "@forge/config": "workspace:*",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "check-types": {
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
